# ──────────────────────────────────────────────────────────────────
# Frontend — exposed to the client JS bundle at build time (VITE_ prefix)
# Get these from Supabase Dashboard → Project Settings → API.
# ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ──────────────────────────────────────────────────────────────────
# Server-side only — used by Netlify Functions (no VITE_ prefix).
# DO NOT add a VITE_ prefix to any of these. They must never enter the bundle.
# ──────────────────────────────────────────────────────────────────

# Same project URL as VITE_SUPABASE_URL, but read by functions.
SUPABASE_URL=

# Service role key — full DB access. Used only by Netlify functions.
SUPABASE_SERVICE_ROLE_KEY=

# Admin login password (functions check input against this).
ADMIN_PASSWORD=

# 32+ random chars. Used to HMAC-sign admin session tokens.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_SECRET=
